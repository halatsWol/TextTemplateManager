<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Console subsystem so a shell (incl. remote PowerShell) waits for us and gets the exit code;
         the console window is hidden immediately when we run the GUI (see Program.cs). -->
    <OutputType>Exe</OutputType>
    <!-- net*-windows gives the in-box Microsoft.Win32.Registry APIs without a package reference. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>

    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>TextTemplateManager-Support-Cleanup</AssemblyName>
    <RootNamespace>TtmCleanup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Keep the single file lean; no globalization/ICU, no debugger metadata in release. -->
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

</Project>
